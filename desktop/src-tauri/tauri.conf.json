{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Funcode Web Architect",
  "version": "0.1.0",
  "identifier": "com.funcodestudiocb.webarchitect",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Funcode Web Architect",
        "width": 1320,
        "height": 840,
        "minWidth": 980,
        "minHeight": 640,
        "backgroundColor": "#050a18"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Funcode Studio CB",
    "shortDescription": "Creación de sitios y aplicaciones web a partir de descripciones",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
